# Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# Optional — landing generator hero images (topic + pitch search on Unsplash).
# Create a (free) developer app: https://unsplash.com/oauth/applications
# In the app, copy the "Access Key" (same value sent as Client-ID to the API).
# Put the real value in .env.local (never commit secrets).
UNSPLASH_ACCESS_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# HIGGSFIELD — image + video generation (the marketing worker's camera)
# ─────────────────────────────────────────────────────────────────────────────
# Higgsfield issues a PAIR: an API Key ID and an API Key Secret. The wire format
# is  Authorization: Key <id>:<secret>  against https://platform.higgsfield.ai
# (this is NOT a Bearer token — a single key alone will 401).
# Paste each half below. Never commit this file; rotate the pair if it is ever
# pasted into a chat, a screenshot, or a ticket.
HIGGSFIELD_KEY_ID=
HIGGSFIELD_KEY_SECRET=
# Optional. Only set these if your account routes differently to the defaults
# (platform.higgsfield.ai · /v1/text2image/soul · /v1/image2video/dop).
HIGGSFIELD_BASE_URL=
HIGGSFIELD_IMAGE_PATH=
HIGGSFIELD_VIDEO_PATH=
HIGGSFIELD_VIDEO_MODEL=

# ─────────────────────────────────────────────────────────────────────────────
# SOCIAL PUBLISHING — one key posts to every network
# ─────────────────────────────────────────────────────────────────────────────
# Without this the Social worker writes drafts and nothing ever leaves the room.
# Ayrshare is the aggregator (one key → Instagram, TikTok, X, LinkedIn, FB).
# The profile key is only needed if you run several businesses under one account.
AYRSHARE_API_KEY=
AYRSHARE_PROFILE_KEY=
